VITE_ALLOWED_EMAIL_0=user0@gmail.com
VITE_ALLOWED_EMAIL_1=user1@gmail.com
VITE_USER0_NICKNAME=PlayerOne
VITE_USER1_NICKNAME=PlayerTwo
# Steam IDs are server-side only — set STEAM_ID_0 / STEAM_ID_1 in functions/.env
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
# Set to true only when running: firebase emulators:start --only functions
VITE_USE_FUNCTIONS_EMULATOR=false
# Dynamic rotating background (default on). Set false to disable.
VITE_ENABLE_DYNAMIC_BG=true
