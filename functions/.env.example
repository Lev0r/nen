# Copy to functions/.env — loaded on deploy (do not commit .env)
ALLOWED_EMAIL_0=user0@gmail.com
ALLOWED_EMAIL_1=user1@gmail.com
# GeForce NOW GraphQL catalog region (default NP-WAW-01 Warsaw, Eastern Europe)
GFN_VPC_ID=NP-WAW-01
# IsThereAnyDeal — historical low price checks (https://isthereanydeal.com/apps/my/)
ITAD_API_KEY=your_itad_api_key
# ITAD country for price comparison (default UA for UAH Steam prices)
ITAD_COUNTRY=UA
# Steam Web API — owned games + wishlist sync (https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=
# 64-bit Steam IDs for User 0 / User 1 (public game details required)
STEAM_ID_0=
STEAM_ID_1=
